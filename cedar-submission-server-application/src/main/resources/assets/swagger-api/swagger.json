{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "Better Metadata - Better Science\n\nThe submission server takes CEDAR metadata to the repositories that expect it in their own\nshape: NCBI BioSample and AIRR, ImmPort, and LINCS.\n\nTwo things happen here. Validation converts a CEDAR instance into the target format and returns\nthat repository's own verdict on it, sending nothing. Submission receives a package of files a\nchunk at a time, assembles it, and forwards it once the last chunk lands — so a successful\nresponse means the chunk was stored and any submission it completed was started, not that the\nrepository has accepted anything.\n",
    "title" : "CEDAR Submission Server API",
    "version" : "2.9.26"
  },
  "paths" : {
    "/" : {
      "get" : {
        "operationId" : "showInfo",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object"
                }
              }
            },
            "description" : "The service name and links to its API documentation"
          }
        },
        "summary" : "Describe this CEDAR service",
        "tags" : [ "Service" ]
      }
    },
    "/command/immport-submit" : {
      "post" : {
        "description" : "Receive the files of an ImmPort submission, assemble them in CEDAR, and once they are all present submit them to the named workspace. The package arrives a chunk at a time, so a caller sends this repeatedly; the submission starts by itself once the last chunk lands. A 200 therefore means the chunk was stored and any submission it completed was started, not that the repository has accepted anything. While the package is still arriving the response is an empty object rather than a submission result.",
        "operationId" : "submitImmPort",
        "responses" : {
          "200" : {
            "description" : "The chunk was stored; ImmPort's result if this completed the submission, an empty object if not"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "Not a multipart upload, no workspace was named, or the chunk is refused because an upload field is missing or malformed or the chunk disagrees with the upload it belongs to. The message names the problem."
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request carries no valid credentials"
          },
          "406" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The request does not accept a JSON response"
          },
          "415" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The body is not declared as multipart/form-data"
          },
          "429" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The deployment limits each user's request rate, and the caller exceeded it"
          },
          "500" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "No ImmPort token is available, or ImmPort could not be reached or refused the submission, or the chunk could not be stored"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CedarError"
                }
              }
            },
            "description" : "The graph database, or another service the request depends on, is unavailable"
          }
        },
        "security" : [ {
          "api_key" : [ ]
        } ],
        "summary" : "Upload a submission package and send it to ImmPort",
        "tags" : [ "ImmPort" ]
      }
    },
